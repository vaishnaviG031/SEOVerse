# Copy to .env and fill only credentials you use.
ENVIRONMENT=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
COOKIE_SECURE=false
MODEL=ollama/llama3.2:1b
YOUTUBE_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
SERPER_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@example.com
# Only for a frontend intentionally hosted on a separate origin.
CORS_ORIGINS=
